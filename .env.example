OPENAI_API_KEY=
OPENAI_BASE_URL=
CHAT_MODEL=stepfun/step-3.5-flash:free
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

TOP_K=3
RETRIEVAL_SEARCH_TYPE=similarity
RETRIEVAL_FETCH_K=8
RERANKER_ENABLED=false
RERANKER_STRATEGY=embedding_lexical
RETRIEVAL_MAX_CONTEXT_CHARS=4000
CHUNK_SIZE=800
CHUNK_OVERLAP=120
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_FILE_NAME=app.log
CHECKPOINTER_TYPE=sqlite
CHECKPOINTER_SQLITE_PATH=./storage/checkpoints.sqlite3
FEEDBACK_LOG_PATH=./storage/feedback.jsonl

DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=./storage/uploads
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
HOT_QUESTION_CACHE_ENABLED=true
HOT_QUESTION_CACHE_TTL_SECONDS=300
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-rag
LANGSMITH_ENDPOINT=
TOKEN_INPUT_COST_PER_1K=0
TOKEN_OUTPUT_COST_PER_1K=0
ALIST_BASE_URL=
ALIST_USERNAME=
ALIST_PASSWORD=
ALIST_CLIENT_ID=rag-langchain-backend
GAZETTEER_FILE_SYNC_ENABLED=true
GAZETTEER_FILE_SYNC_INTERVAL_SECONDS=21600
GAZETTEER_FILE_ROOT_PATH=/百度网盘/全国地方县志古籍收藏
OLD_PICTURE_SYNC_ENABLED=true
OLD_PICTURE_SYNC_INTERVAL_SECONDS=21600
OLD_PICTURE_ROOT_PATH=/夸克/一万张历史老照片

# Docker Compose api/worker services override database and Redis URLs to use
# internal service names: postgres and redis. If you use bge-m3, set
# EMBEDDING_DIMENSION=1024 before running migrations.
